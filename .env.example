# Copy to .env.local for localhost. In Vercel, add the same names under
# Project → Settings → Environment Variables.

# --- Public (safe in the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_, never paste in chat) ---
# Free: picks the best YouTube video for each dish (YouTube Data API v3). Optional.
YOUTUBE_API_KEY=

# --- Rate limiting (Upstash Redis via Vercel Marketplace). Optional on localhost. ---
# Coin packs through RevenueCat (Apple Pay / Google Pay / card on your Stripe account). Server only. Optional.
REVENUECAT_PURCHASE_LINK=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_ALLOW_SANDBOX=1   # only while testing

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
