# Copy to .env.local for localhost. In Vercel, add the same names under
# Project → Settings → Environment Variables.

# --- Public (safe in the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_, never paste in chat) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for recipes
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Rate limiting (Upstash Redis via Vercel Marketplace). Optional on localhost. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
