# Copy to .env.local for localhost. In Vercel, add the same names under
# Project → Settings → Environment Variables.

# --- Public (safe in the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_, never paste in chat) ---
# Free: picks the best YouTube video for each dish (YouTube Data API v3). Optional.
YOUTUBE_API_KEY=
# Costs money per use; only receipt photos use it. Leave empty to keep Whisk free to run.
ANTHROPIC_API_KEY=

# --- Rate limiting (Upstash Redis via Vercel Marketplace). Optional on localhost. ---
# Coin packs: Apple Pay / Google Pay / card via Stripe Checkout (server only, never NEXT_PUBLIC_). Optional.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
